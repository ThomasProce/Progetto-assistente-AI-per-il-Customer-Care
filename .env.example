# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=sk-...

# LiteLLM model identifiers: OpenAI names are recognised as-is, other providers use "provider/model"
GREENTHUMB_LLM_MODEL=gpt-4o-mini-2024-07-18
GREENTHUMB_EMBEDDING_MODEL=text-embedding-3-small
GREENTHUMB_EVAL_MODEL=gpt-4o-2024-11-20

# Simulated "today" for the demo: orders.json is generated relative to this date
GREENTHUMB_CURRENT_DATE=2026-06-16

# Retrieval (long-term semantic memory)
GREENTHUMB_CHUNK_SIZE=900
GREENTHUMB_CHUNK_OVERLAP=150
GREENTHUMB_RETRIEVAL_FETCH_K=12
GREENTHUMB_RETRIEVAL_TOP_K=4
GREENTHUMB_MAX_CHUNKS_PER_DOC=2
GREENTHUMB_RETRIEVAL_TOP_DOCS=3
GREENTHUMB_HYBRID_SEARCH=true
GREENTHUMB_PARENT_DOCUMENT=true
GREENTHUMB_MIN_RELEVANCE_SCORE=0.35
GREENTHUMB_HIGH_CONFIDENCE_SCORE=0.45

# Short-term memory: "summarization" (default) or "trimming"
GREENTHUMB_MEMORY_STRATEGY=summarization
GREENTHUMB_MEMORY_MAX_TOKENS=1200
GREENTHUMB_MEMORY_KEEP_LAST_MESSAGES=4

# ReAct loop
GREENTHUMB_MAX_AGENT_ITERATIONS=6
